<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <system.webServer>

        <!-- =========================================================
             1. REMOVE WEBDAV
             Required when backend APIs use:
             PUT / DELETE / PATCH
        ========================================================== -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <handlers>
            <remove name="WebDAV" />
        </handlers>


        <!-- =========================================================
             2. STATIC CONTENT MIME TYPES
        ========================================================== -->
        <staticContent>

            <!-- Web App Manifest -->
            <remove fileExtension=".webmanifest" />
            <mimeMap
                fileExtension=".webmanifest"
                mimeType="application/manifest+json" />

        </staticContent>


        <!-- =========================================================
             3. URL REWRITE RULES
        ========================================================== -->
        <rewrite>

            <rules>


                <!-- =================================================
                     RULE 1
                     HTTP + WWW -> HTTPS NON-WWW

                     Examples:

                     http://innrly.com/about
                     ->
                     https://innrly.com/about

                     http://www.innrly.com/about
                     ->
                     https://innrly.com/about

                     https://www.innrly.com/about
                     ->
                     https://innrly.com/about

                     Prevents redirect chains.
                ================================================== -->

                <rule
                    name="Canonical HTTPS Non-WWW"
                    stopProcessing="true">

                    <match url="(.*)" />

                    <conditions logicalGrouping="MatchAny">

                        <!-- HTTP -->
                        <add
                            input="{HTTPS}"
                            pattern="^OFF$"
                            ignoreCase="true" />

                        <!-- WWW -->
                        <add
                            input="{HTTP_HOST}"
                            pattern="^www\.innrly\.com$"
                            ignoreCase="true" />

                    </conditions>

                    <action
                        type="Redirect"
                        url="https://innrly.com/{R:1}"
                        redirectType="Permanent"
                        appendQueryString="true" />

                </rule>


                <!-- =================================================
                     RULE 2
                     API REVERSE PROXY

                     Public:
                     /api/users
                     /api/login
                     /api/leads/123

                     Internal:
                     localhost:8005/users
                     localhost:8005/login
                     localhost:8005/leads/123
                ================================================== -->

                <rule
                    name="API Reverse Proxy"
                    stopProcessing="true">

                    <match
                        url="^api(?:/(.*))?$"
                        ignoreCase="true" />

                    <action
                        type="Rewrite"
                        url="http://localhost:8005/{R:1}"
                        appendQueryString="true" />

                </rule>


                <!-- =================================================
                     RULE 3
                     PYTHON DIRECT ENDPOINTS

                     /leads
                     /leads/123

                     /upload
                     /uploads
                     /uploads/file.pdf

                     /telemetry
                     /telemetry/...

                     /admin
                     /admin/...
                ================================================== -->

                <rule
                    name="Python Backend Direct Endpoints"
                    stopProcessing="true">

                    <match
                        url="^(leads|uploads?|telemetry|admin)(/.*)?$"
                        ignoreCase="true" />

                    <action
                        type="Rewrite"
                        url="http://localhost:8005/{R:0}"
                        appendQueryString="true" />

                </rule>


                <!-- =================================================
                     RULE 4
                     NODE.JS FRONTEND

                     Everything not handled above goes to:

                     localhost:3000
                ================================================== -->

                <rule
                    name="Node Frontend Reverse Proxy"
                    stopProcessing="true">

                    <match
                        url="(.*)"
                        ignoreCase="true" />

                    <action
                        type="Rewrite"
                        url="http://localhost:3000/{R:1}"
                        appendQueryString="true" />

                </rule>


            </rules>

        </rewrite>


        <!-- =========================================================
             4. SECURITY
        ========================================================== -->

        <security>

            <requestFiltering
                allowDoubleEscaping="false">

                <!-- Adjust if large file uploads are required -->
                <requestLimits
                    maxAllowedContentLength="52428800" />

            </requestFiltering>

        </security>


        <!-- =========================================================
             5. RESPONSE HEADERS
        ========================================================== -->

        <httpProtocol>

            <customHeaders>

                <!-- Information Disclosure Protection -->
                <remove name="X-Powered-By" />

                <!-- Transport Security (HSTS) -->
                <remove name="Strict-Transport-Security" />
                <add
                    name="Strict-Transport-Security"
                    value="max-age=31536000; includeSubDomains; preload" />

                <!-- Clickjacking Protection -->
                <remove name="X-Frame-Options" />
                <add
                    name="X-Frame-Options"
                    value="SAMEORIGIN" />

                <!-- MIME Sniffing Protection -->
                <remove name="X-Content-Type-Options" />
                <add
                    name="X-Content-Type-Options"
                    value="nosniff" />

                <!-- Referrer Policy -->
                <remove name="Referrer-Policy" />
                <add
                    name="Referrer-Policy"
                    value="strict-origin-when-cross-origin" />

                <!-- Permissions Policy -->
                <remove name="Permissions-Policy" />
                <add
                    name="Permissions-Policy"
                    value="camera=(), microphone=(), geolocation=()" />

            </customHeaders>

        </httpProtocol>


        <!-- =========================================================
             6. ERROR HANDLING

             Pass application errors through so Node/Python can
             control their own 404 / 500 responses.
        ========================================================== -->

        <httpErrors
            existingResponse="PassThrough" />


    </system.webServer>
</configuration>
